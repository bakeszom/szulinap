# Szülinapi gyűjtőszolgáltatás – másold .env néven, és töltsd ki. A .env SOHA ne kerüljön gitbe.

# ── Supabase (a buliappé) ──────────────────────────────────────────────────
# Az URL és a nyilvános kulcs alapból a buliappé; csak a titkot kell megadni.
# A BRIDGE_SECRET SHA-256 hash-e van a supabase-v4-adomany.sql-ben (bridge_keys tábla).
BRIDGE_SECRET=
# SUPABASE_URL=https://nrxalvrmupcgorkzobru.supabase.co
# SUPABASE_KEY=sb_publishable_…

# ── SumUp (ugyanaz a sandbox-fiók, mint a snapify-pay-ben) ─────────────────
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_AFFILIATE_APP_ID=
SUMUP_AFFILIATE_KEY=
# A terminál: npm run pair -- <KÓD> írja ki (Virtual Solo: virtual-solo.sumup.com → Generate pairing code)
SUMUP_READER_ID=
# Éles (nem sandbox) fiókkal csak SUMUP_ALLOW_LIVE=true mellett indul el (valódi pénz!)
SUMUP_ALLOW_LIVE=false
# A terminálon és a SumUp-kivonaton megjelenő leírás
PAYMENT_DESCRIPTION=Ádám esküvőjére
# Ennyi mp-ig vár a terminál a kártyára, utána megszakítja (max. 240)
CHECKOUT_MAX_WAIT_S=120

# ── Szelfigép-számláló (snapify) ───────────────────────────────────────────
SNAPIFY_EVENT_SLUG=bach-adam-29
# Belépés: a `npm run snapify-esemeny` oldal elmenti a tokent a data/snapify-token.txt-be (30 napig jó).
# Másik gépen: vagy másold át azt a fájlt, vagy add meg itt a tokent, vagy az e-mailt + jelszót.
SNAPIFY_TOKEN=
# SNAPIFY_EMAIL=
# SNAPIFY_PASSWORD=

# ── Helyi kezelőoldal ──────────────────────────────────────────────────────
HTTP_HOST=127.0.0.1
HTTP_PORT=8788
